---
import { withBase } from '../lib/paths';

interface Props {
  lang?: 'en' | 'zh';
  // This page in the other language. A plain link, so crawlers find both versions.
  otherLangHref?: string;
}

const { lang = 'en', otherLangHref } = Astro.props;
const repo = process.env.GITHUB_REPOSITORY || 'Kepler2024/Codesheet';
const homeHref = withBase(lang === 'zh' ? '/zh/' : '/');
---

<footer class="site-footer">
  <div class="footer-content">
    <div>
      {lang === 'zh' ? (
        <p><strong>Codesheet</strong> — 2026 面向开发者的轻量速查手册，快速上手一门新语言。</p>
      ) : (
        <p><strong>Codesheet</strong> — A lightweight 2026 quick reference for developers coding in a new language.</p>
      )}
    </div>
    <div class="footer-links">
      <a href={homeHref} class="footer-link">{lang === 'zh' ? '首页' : 'Home'}</a>
      <a href={`https://github.com/${repo}/blob/main/${lang === 'zh' ? 'CONTRIBUTING.zh-CN.md' : 'CONTRIBUTING.md'}`} target="_blank" rel="noopener noreferrer" class="footer-link">{lang === 'zh' ? '贡献指南' : 'Contributing'}</a>
      <a href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
      {otherLangHref && (lang === 'zh' ? (
        <a href={otherLangHref} hreflang="en" lang="en" class="footer-link">English</a>
      ) : (
        <a href={otherLangHref} hreflang="zh-CN" lang="zh-CN" class="footer-link">简体中文</a>
      ))}
    </div>
  </div>
</footer>
