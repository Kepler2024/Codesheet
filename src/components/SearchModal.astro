---
interface SearchItem {
  id: string;
  section: string;
  title: string;
  type: 'heading' | 'gotcha' | 'code' | 'text';
  text: string;
  snippet?: string;
}

interface Props {
  sheetName: string;
  lang?: 'en' | 'zh';
  searchIndex: SearchItem[];
}

const { sheetName, lang = 'en', searchIndex = [] } = Astro.props;

const placeholder = lang === 'zh'
  ? `搜索关键词... (⌘K)`
  : `Search keywords... (⌘K)`;

const emptyTip = lang === 'zh'
  ? '输入关键词快速定位章节与语法'
  : 'Type keywords to find sections or syntax';

const noResults = lang === 'zh'
  ? '未找到匹配结果'
  : 'No matching results';
---

<div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="Search" style="display: none;">
  <div class="search-modal-backdrop" id="search-backdrop"></div>

  <div class="search-modal-container">
    <div class="search-modal-box">
      <!-- Search Input Bar -->
      <div class="search-input-header">
        <svg class="search-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>

        <input
          id="search-input"
          class="search-input"
          type="search"
          placeholder={placeholder}
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />

        <button id="search-close-btn" class="search-close-btn" type="button" aria-label="Close">
          <kbd class="search-esc-kbd">ESC</kbd>
        </button>
      </div>

      <!-- Search Results -->
      <div id="search-results-wrapper" class="search-results-wrapper">
        <div id="search-empty-tip" class="search-empty-tip">{emptyTip}</div>
        <ul id="search-results-list" class="search-results-list" role="listbox" style="display: none;"></ul>
        <div id="search-no-results" class="search-empty-tip" style="display: none;">{noResults}</div>
      </div>
    </div>
  </div>
</div>

<!-- Embedded JSON search index -->
<script type="application/json" id="sheet-search-index" set:html={JSON.stringify(searchIndex)} />

<script is:inline>
  (function () {
    const modal = document.getElementById('search-modal');
    const backdrop = document.getElementById('search-backdrop');
    const input = document.getElementById('search-input');
    const closeBtn = document.getElementById('search-close-btn');
    const resultsList = document.getElementById('search-results-list');
    const emptyTip = document.getElementById('search-empty-tip');
    const noResults = document.getElementById('search-no-results');

    const indexElement = document.getElementById('sheet-search-index');
    if (!indexElement || !modal || !input) return;

    let searchItems = [];
    try {
      searchItems = JSON.parse(indexElement.textContent || '[]');
    } catch {
      searchItems = [];
    }

    let activeIndex = -1;
    let currentResults = [];

    function openModal() {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        modal.classList.add('open');
        input.focus();
        input.select();
      }, 10);
    }

    function closeModal() {
      modal.classList.remove('open');
      setTimeout(() => {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }, 150);
    }

    function escapeRegex(str) {
      return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function highlightText(text, query) {
      if (!query || !text) return text;
      const terms = query.trim().split(/\s+/).filter(Boolean);
      if (terms.length === 0) return text;
      const pattern = new RegExp(`(${terms.map(escapeRegex).join('|')})`, 'gi');
      return text.replace(pattern, '<mark class="search-hl">$1</mark>');
    }

    function performSearch(query) {
      const q = query.trim().toLowerCase();
      if (!q) {
        if (emptyTip) emptyTip.style.display = 'block';
        if (resultsList) resultsList.style.display = 'none';
        if (noResults) noResults.style.display = 'none';
        currentResults = [];
        activeIndex = -1;
        return;
      }

      if (emptyTip) emptyTip.style.display = 'none';

      const scored = [];
      const terms = q.split(/\s+/).filter(Boolean);

      for (const item of searchItems) {
        const titleLower = item.title.toLowerCase();
        const textLower = (item.text || '').toLowerCase();
        const sectionLower = (item.section || '').toLowerCase();

        let score = 0;
        let matched = true;

        for (const term of terms) {
          let termScore = 0;
          if (titleLower === term) termScore += 100;
          else if (titleLower.startsWith(term)) termScore += 60;
          else if (titleLower.includes(term)) termScore += 40;

          if (sectionLower.includes(term)) termScore += 25;
          if (textLower.includes(term)) termScore += 15;

          if (termScore === 0) {
            matched = false;
            break;
          }
          score += termScore;
        }

        if (matched && score > 0) {
          scored.push({ item, score });
        }
      }

      scored.sort((a, b) => b.score - a.score);
      currentResults = scored.map((s) => s.item).slice(0, 25);

      renderResults(q);
    }

    function renderResults(query) {
      if (!resultsList) return;
      resultsList.innerHTML = '';

      if (currentResults.length === 0) {
        resultsList.style.display = 'none';
        if (noResults) noResults.style.display = 'block';
        activeIndex = -1;
        return;
      }

      if (noResults) noResults.style.display = 'none';
      resultsList.style.display = 'flex';
      activeIndex = 0;

      currentResults.forEach((item, index) => {
        const li = document.createElement('li');
        li.className = `search-result-item ${index === activeIndex ? 'active' : ''}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', index === activeIndex ? 'true' : 'false');
        li.dataset.index = String(index);

        const highlightedTitle = highlightText(item.title, query);
        const sectionName = item.section || '';

        li.innerHTML = `
          <div class="search-item-left">
            <span class="search-item-hash">#</span>
            <span class="search-item-title">${highlightedTitle}</span>
          </div>
          ${sectionName ? `<span class="search-item-section">${sectionName}</span>` : ''}
        `;

        li.addEventListener('click', () => {
          jumpToTarget(item.id);
        });

        li.addEventListener('mouseenter', () => {
          updateActiveIndex(index);
        });

        resultsList.appendChild(li);
      });
    }

    function updateActiveIndex(newIndex) {
      activeIndex = newIndex;
      const items = resultsList.querySelectorAll('.search-result-item');
      items.forEach((item, idx) => {
        const isActive = idx === activeIndex;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          item.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    function jumpToTarget(targetId) {
      if (!targetId) return;
      closeModal();
      const targetElem = document.getElementById(targetId);
      if (targetElem) {
        targetElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
        targetElem.classList.remove('search-pulse-target');
        void targetElem.offsetWidth; // re-flow
        targetElem.classList.add('search-pulse-target');
        setTimeout(() => {
          targetElem.classList.remove('search-pulse-target');
        }, 2000);
      }
    }

    // Input listener
    input.addEventListener('input', (e) => {
      performSearch(e.target.value);
    });

    // Keyboard navigation
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentResults.length > 0) {
          updateActiveIndex((activeIndex + 1) % currentResults.length);
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentResults.length > 0) {
          updateActiveIndex((activeIndex - 1 + currentResults.length) % currentResults.length);
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && activeIndex < currentResults.length) {
          jumpToTarget(currentResults[activeIndex].id);
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      }
    });

    // Close on backdrop or close button
    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // Global shortcut Cmd+K / Ctrl+K and /
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.classList.contains('open')) {
          closeModal();
        } else {
          openModal();
        }
      } else if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
        e.preventDefault();
        openModal();
      }
    });

    // Trigger buttons
    document.querySelectorAll('[data-action="open-search"]').forEach((btn) => {
      btn.addEventListener('click', openModal);
    });
  })();
</script>
