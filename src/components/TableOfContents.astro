---
import { withBase } from '../lib/paths';

interface HeadingItem {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  headings: HeadingItem[];
  lang?: 'en' | 'zh';
}

const { headings, lang = 'en' } = Astro.props;
const allLanguagesHref = withBase(lang === 'zh' ? '/zh/' : '/');
const allLanguagesText = lang === 'zh' ? '所有语言' : 'All Languages';
const tocTitle = lang === 'zh' ? '本页目录' : 'On This Page';
---

<aside class="doc-sidebar" aria-label="Table of contents">
  <nav class="toc-nav">
    <a href={allLanguagesHref} class="toc-back-link">
      <span>←</span>
      <span>{allLanguagesText}</span>
    </a>

    <div class="toc-search-wrapper">
      <button class="toc-search-btn" type="button" data-action="open-search" aria-label={lang === 'zh' ? '搜索关键词' : 'Search keywords'}>
        <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="toc-search-text">{lang === 'zh' ? '搜索关键词...' : 'Search keywords...'}</span>
        <kbd class="toc-search-kbd">⌘K</kbd>
      </button>
    </div>

    <div class="toc-title">{tocTitle}</div>

    <ul class="toc-list">
      {headings.map((h) => (
        <li class={`toc-item depth-${h.depth}`}>
          <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
