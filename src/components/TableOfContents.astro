---
interface HeadingItem {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;
---

<aside class="doc-sidebar" aria-label="Table of contents">
  <nav class="toc-nav">
    <a href="/" class="toc-back-link">
      <span>←</span>
      <span>All Languages</span>
    </a>

    <div class="toc-title">On This Page</div>

    <ul class="toc-list">
      {headings.map((h) => (
        <li class={`toc-item depth-${h.depth}`}>
          <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
