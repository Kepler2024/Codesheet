---
import Layout from '../layouts/Layout.astro';
import { getAllSheets } from '../lib/sheets';
import { withBase } from '../lib/paths';

const sheets = await getAllSheets();
const sheetSummaries = sheets.map((s) => ({ id: s.id, name: s.name }));

// User preference: Python, TypeScript, C++, Java, JavaScript in the first 5
const PREFERRED_ORDER = [
  'python',
  'typescript',
  'cpp',
  'java',
  'javascript',
  'go',
  'rust',
  'csharp',
  'kotlin',
  'swift',
];

sheets.sort((a, b) => {
  const idxA = PREFERRED_ORDER.indexOf(a.id);
  const idxB = PREFERRED_ORDER.indexOf(b.id);
  return (idxA === -1 ? 999 : idxA) - (idxB === -1 ? 999 : idxB);
});
---

<Layout
  title="Codesheet — Programming Language Cheat Sheets (2026)"
  description="A lightweight 2026 quick reference for developers coding in a new language. Easy to read, clearly sectioned, and friendly to newcomers. One page per language covering core syntax, common data structures, and gotchas. Ideal for LeetCode practice, quick onboarding, or refreshing rusty syntax."
  sheets={sheetSummaries}
>
  <main class="page-container home-page-container">
    <div class="home-content">
      <section class="index-hero">
        <h1 class="index-title">
          A lightweight 2026 quick reference<br class="title-br" /> for developers coding in a new language.
        </h1>

        <p class="index-description">
          Easy to read, clearly sectioned, and friendly to newcomers.<br class="desc-br" />
          Covers core syntax, common data structures, and gotchas, verified by real toolchains.<br class="desc-br" />
          Ideal for LeetCode practice, quick onboarding, or refreshing rusty syntax.
        </p>
      </section>

      <section class="index-grid-section">
        <div class="sheet-grid">
          {sheets.map((sheet) => (
            <a href={withBase(`/${sheet.id}/`)} class="lang-tile" aria-label={`${sheet.name} Cheat Sheet`}>
              <div class="tile-icon-wrapper">
                <img src={withBase(`/icons/${sheet.id}.svg`)} alt="" class="tile-icon" width="42" height="42" loading="lazy" />
              </div>
              <h2 class="tile-name">{sheet.name}</h2>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
