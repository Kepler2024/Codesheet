---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SearchModal from '../../components/SearchModal.astro';
import { getAllSheets, renderSheet, buildSearchIndex } from '../../lib/sheets';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const sheets = await getAllSheets('zh');
  const allSummaries = sheets.map((s) => ({ id: s.id, name: s.name }));

  return await Promise.all(
    sheets.map(async (sheet) => {
      const renderedHtml = await renderSheet(sheet, 'zh');
      const searchIndex = buildSearchIndex(sheet.rawContent, sheet.headings, 'zh');
      return {
        params: { id: sheet.id },
        props: {
          sheet,
          renderedHtml,
          searchIndex,
          allSummaries,
        },
      };
    })
  );
}

const { sheet, renderedHtml, searchIndex, allSummaries } = Astro.props;
---

<Layout
  title={`${sheet.name} 速查表 — Codesheet`}
  description={sheet.intro || `${sheet.name} 编程语言速查表，覆盖核心语法与常用数据结构。`}
  sheets={allSummaries}
  currentId={sheet.id}
  lang="zh"
>
  <div class="page-container">
    <div class="doc-layout">
      <TableOfContents headings={sheet.headings} lang="zh" />

      <main class="doc-content">
        <section class="page-hero">
          <nav class="breadcrumbs" aria-label="面包屑导航">
            <a href={withBase('/zh/')}>首页</a>
            <span>/</span>
            <span style="color: var(--text-primary); font-weight: 500;">{sheet.name}</span>
          </nav>

          <div class="hero-header">
            <h1 class="page-title">{sheet.name} 速查表</h1>
            <p class="hero-version">
              <svg class="hero-version-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              <span>适用于 {sheet.version}</span>
            </p>
          </div>

          {sheet.intro && <p class="intro-text">{sheet.intro}</p>}

          <div class="hero-actions">
            <button class="hero-search-btn" type="button" data-action="open-search" aria-label="搜索速查表文档">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span>搜索文档 (⌘K)</span>
            </button>

            <a
              href={sheet.editUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="edit-btn"
              aria-label={`在 GitHub 上编辑 ${sheet.name} 速查表`}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
              <span>在 GitHub 上编辑此页</span>
            </a>
          </div>
        </section>

        <article class="sheet-article" set:html={renderedHtml} />
      </main>
    </div>

    <SearchModal sheetName={sheet.name} lang="zh" searchIndex={searchIndex} />
  </div>
</Layout>
